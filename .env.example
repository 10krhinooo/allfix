# The AllFix backend. No secret belongs in this file or in any NEXT_PUBLIC_ variable:
# everything here is compiled into the browser bundle.
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_SITE_URL=http://localhost:3007

# Server only, and read in `src/lib/admin/accounts.ts`. Every seeded account
# opens with whatever this is set to. Unset, the password is not checked at all
# and any value opens a seeded account, including an empty one, which is what
# keeps a bare clone usable. Set it anywhere the console is reachable by
# somebody who should not be able to walk in. It is not `NEXT_PUBLIC_`, so it
# never reaches the browser.
#
# The value lives in `.env.local` rather than in the source because a credential
# committed to the repository is read as a leak by a secret scanner whatever it
# actually guards. That reasoning applies to this file too, which is why no
# password is written here.
ALLFIX_SEED_PASSWORD=

# Signs the session cookie (`src/lib/admin/session.ts`). Set this wherever the
# console is real. Unset, the behaviour depends on `NODE_ENV`: outside production
# the key is a stand-in generated per process, so restarting the server signs you
# out, and in production there is no key at all and the door refuses to issue a
# session, answering every sign in with 503. That refusal is deliberate, because
# signing with a key anybody can read is not signing.
#
# At least 32 characters, or it is refused the same way an absent one is: a key
# shorter than the signature it produces is not a key. Surrounding whitespace is
# trimmed, so a value that picked up a newline is still the value you meant.
#
# Generate one with `openssl rand -base64 32`, and give each deployment its own,
# so a leaked preview key cannot forge a production session.
ALLFIX_SESSION_SECRET=
