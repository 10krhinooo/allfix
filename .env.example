# The AllFix backend. No secret belongs in this file or in any NEXT_PUBLIC_ variable:
# everything here is compiled into the browser bundle.
NEXT_PUBLIC_API_URL=http://localhost:8087
NEXT_PUBLIC_SITE_URL=http://localhost:3007

# Server only, and read in `src/lib/admin/accounts.ts`. Every seeded account
# opens with whatever this is set to. Unset, the password is not checked at all
# and any value opens a seeded account, including an empty one, which is what
# keeps a bare clone usable. Set it anywhere the console is reachable by
# somebody who should not be able to walk in. It is not `NEXT_PUBLIC_`, so it
# never reaches the browser.
#
# The value lives in `.env.local` rather than in the source because a credential
# committed to the repository is read as a leak by a secret scanner whatever it
# actually guards. That reasoning applies to this file too, which is why no
# password is written here.
ALLFIX_SEED_PASSWORD=

# Signs the session cookie (`src/lib/admin/session.ts`). Set this wherever the
# console is real. Unset, the behaviour depends on `NODE_ENV`: outside production
# the key is a stand-in generated per process, so restarting the server signs you
# out, and in production there is no key at all and the door refuses to issue a
# session, answering every sign in with 503. That refusal is deliberate, because
# signing with a key anybody can read is not signing.
#
# At least 32 characters, or it is refused the same way an absent one is: a key
# shorter than the signature it produces is not a key. Surrounding whitespace is
# trimmed, so a value that picked up a newline is still the value you meant.
#
# Generate one with `openssl rand -base64 32`, and give each deployment its own,
# so a leaked preview key cannot forge a production session.
ALLFIX_SESSION_SECRET=

# How long a signed in account may do nothing before the shop signs it out, in
# whole minutes. Unset, it is 20. Anything that is not a whole number between 5
# and 480 is ignored and the default is used, because the failure mode of a typo
# here should be the window somebody expected and never no timeout at all.
#
# This is the fallback. Once a settings service is reachable the owner sets it on
# /admin/settings and this is only what a bare clone runs on. It applies to every
# account, the counter and customers alike, and the window slides on activity
# rather than counting from sign in.
ALLFIX_SESSION_IDLE_MINUTES=

# The Quarkus backend, read server to server and never from the browser. Unset,
# the seams in `registration.ts`, `settings-service.ts` and `orders-api.ts` fall
# back to the environment and say plainly what they could not keep.
#
# Locally that is `http://localhost:8087`, which is where `./mvnw quarkus:dev`
# in `allfix-backend` puts it. Not 8080: sibling projects on the same machine
# already have that one, and a service answering somebody else's routes is a
# confusing afternoon.
ALLFIX_API_URL=

# The shop's social accounts, read by the footer when there is no settings
# service. None is set, and the footer draws nothing rather than dead icons.
ALLFIX_SOCIAL_INSTAGRAM=
ALLFIX_SOCIAL_FACEBOOK=
ALLFIX_SOCIAL_TIKTOK=
ALLFIX_SOCIAL_X=
ALLFIX_SOCIAL_LINKEDIN=
ALLFIX_SOCIAL_YOUTUBE=

# How the shop's own messages are addressed, same fallback as the links above.
ALLFIX_MAIL_FROM_NAME=
ALLFIX_MAIL_FROM=
ALLFIX_MAIL_REPLY_TO=
ALLFIX_MAIL_COPY_TO=

# How the Next server proves it is the Next server when it reads and writes the
# settings the console owns. Those endpoints are ADMIN only and this server holds
# no account, so without this every call is anonymous, comes back 401 and is
# swallowed by the fallback above: the symptom is a social link that saves and
# never appears.
#
# It grants ADMIN, so treat it as a password. At least 32 characters, a distinct
# value per environment, and it must match `allfix.service.token` on the backend.
# Not NEXT_PUBLIC_, and never read from a client component.
#
# Generate one with `openssl rand -base64 32`.
ALLFIX_SERVICE_TOKEN=
