#!/bin/sh
# A commit message ends at its last real sentence: no em dash, and no trailer
# naming a tool, both of which the project rules out.
set -e

EM=$(printf '\342\200\224')

body=$(grep -v '^#' "$1")

if echo "$body" | grep -n "$EM" >/dev/null; then
  echo "commit-msg: the message has an em dash. Use a comma, colon or a plain hyphen." >&2
  exit 1
fi

if echo "$body" | grep -niE '^(co-authored-by|generated with)' >/dev/null; then
  echo "commit-msg: the message carries a trailer. End it at the last real sentence." >&2
  exit 1
fi
